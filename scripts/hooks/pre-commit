#!/bin/bash
# Thin staged-tree guardrail: validate the staged tree with existing cheap checks.
# Documentation changes trigger guidance and localization on an index snapshot;
# relevant Swift changes trigger project-supported scoped lint. No autofix, no
# re-staging, no version bump, no full build or test runs here.
# Never stashes, restores, or mutates the index/worktree; the snapshot is
# temporary and removed on pass or fail.
set -euo pipefail

say() { printf '%s\n' "$*"; }
fail() { printf 'pre-commit: BLOCKED %s\n' "$1" >&2; exit 1; }

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "${SCRIPT_DIR}/../.." && pwd)"
cd "${PROJECT_ROOT}"

# GUI clients may provide a reduced PATH that does not include Homebrew's bin
# directory. Resolve the installed tools explicitly so the hook behaves the
# same from a terminal and from a desktop Git client.
find_tool() {
    local tool="$1"

    if command -v "${tool}" &> /dev/null; then
        command -v "${tool}"
        return 0
    fi

    for candidate in \
        "/opt/homebrew/bin/${tool}" \
        "/usr/local/bin/${tool}"; do
        if [ -x "${candidate}" ]; then
            echo "${candidate}"
            return 0
        fi
    done

    return 1
}

tmp=$(mktemp -d "${TMPDIR:-/tmp}/verbi-precommit.XXXXXX")
trap 'rm -rf "$tmp"' EXIT

# Scopes the checker reads: Markdown docs, the Makefile target table, and the
# project agent directory.
guidance_needed=0
strings_or_swift_staged=0
swift_paths=()
while IFS= read -r -d '' path; do
    case "$path" in
        *.md|Makefile) guidance_needed=1 ;;
    esac
    case "$path" in
        .agents/*) guidance_needed=1 ;;
    esac
    case "$path" in
        *.swift|*.strings) strings_or_swift_staged=1 ;;
    esac
    case "$path" in
        *.swift) swift_paths+=("$path") ;;
    esac
done < <(git diff --cached --name-only --diff-filter=ACMR -z)

git diff --cached --check || fail 'staged whitespace errors; fix them and retry'

snapshot=""
if ((guidance_needed)) || ((strings_or_swift_staged)); then
    snapshot="$tmp/staged"
    mkdir -p "$snapshot"
    git checkout-index --prefix="$snapshot/" -a -f -q
fi

if ((guidance_needed)); then
    say 'pre-commit: validating staged guidance'
    VERBI_ROOT="$snapshot" python3 scripts/validate-agent-guidance.py \
        || fail 'staged tree failed guidance; fix staged content and retry (worktree may differ)'
fi

if ((strings_or_swift_staged)); then
    say 'pre-commit: validating staged localization keys'
    python3 scripts/check-localization.py --root "$snapshot" \
        || fail 'staged tree failed localization; fix staged content and retry (worktree may differ)'
fi

if ((${#swift_paths[@]} > 0)); then
    if find_tool swiftformat >/dev/null 2>&1 && find_tool swiftlint >/dev/null 2>&1; then
        lint_targets=()
        deferred=0
        for path in "${swift_paths[@]}"; do
            # The --files contract is space-separated, so paths with spaces
            # cannot be passed faithfully; defer those with an explicit note.
            # Lint the worktree file only when it is byte-identical to the
            # staged blob; otherwise the staged content cannot be proven here.
            case "$path" in
                *' '*) deferred=1 ;;
                *)
                    if git diff --quiet -- "$path"; then
                        lint_targets+=("$path")
                    else
                        deferred=1
                    fi
                    ;;
            esac
        done
        if ((${#lint_targets[@]} > 0)); then
            say 'pre-commit: running scoped lint on staged Swift'
            ./scripts/lint.sh --files "${lint_targets[*]}" \
                || fail 'staged Swift failed lint; fix staged content or run: make lint-agent'
        fi
        if ((deferred)); then
            say 'pre-commit: note: some staged Swift differs from worktree or has spaces; scoped lint deferred, run: make lint-agent'
        fi
    else
        say 'pre-commit: note: SwiftFormat/SwiftLint not installed; scoped lint deferred'
    fi
fi
