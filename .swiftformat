# Mirror of the shared Swift baseline that `make lint` and `make format` use
# (${AGENT_CONFIG_HOME:-~/.agents}/skills/swift-conventions/config/.swiftformat).
# Keep it identical to that baseline; only the exclude line below is local.

# Swift 6 language mode on the Swift 6.4 compiler (Xcode 27).
--swiftversion 6.0
--indent 4
--linebreaks lf
--trimwhitespace always
--commas inline
--wraparguments before-first
--wrapcollections before-first
--importgrouping alpha
--nilinit remove

# NÃO ativados de propósito (documentado):
# --self remove: 578 usos de `self.`; remoção em massa poluiria o diff.
#   Cobrir incrementalmente por arquivo tocado, não global.
# --semicolons never: quebraria o padrão `lock.lock(); defer {}` (legítimo).

# Regras novas do SwiftFormat 0.64 desligadas (2026-11-11): reescrevem lógica
# (juntam guards e ifs, movem atributos) em vez de só formatar. Avaliar
# adoção num passo próprio, fora de trabalho em andamento.
--disable repeatedGuard,nestedIf,extensionAttributes

# Repository paths (local to Verbi)
--exclude .build,DerivedData,.swiftpm,dist,build,**/build/**,**/GeneratedMocks.swift,**/Generated/**
